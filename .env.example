# Copy application settings to server/.env (see server/.env.example).
# Shell/checker variables override server/.env. Root .env is read by Compose,
# not automatically by npm, the checker, or the application.
PORT=4000
WEB_ORIGIN=http://localhost:5173
GRADER_TOKEN=REPLACE_WITH_GRADER_TOKEN
MONGO_URL=mongodb://localhost:27017/switchboard
REDIS_URL=redis://localhost:6379
PIGEON_URL=http://localhost:4010
PIGEON_WEBHOOK_SECRET=REPLACE_WITH_PIGEON_WEBHOOK_SECRET
PIGEON_KEY_WS_ACME=REPLACE_WITH_ACME_API_KEY
PIGEON_KEY_WS_GLOBEX=REPLACE_WITH_GLOBEX_API_KEY
OIDC_ISSUER=http://localhost:4020
OIDC_CLIENT_ID=switchboard-web
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
OIDC_REDIRECT_URI=http://localhost:4000/auth/callback

# Compose webhook destinations; defaults preserve the supplied host topology.
PIGEON_TARGET_URL=http://host.docker.internal:4000/webhooks/pigeon
PAYBOX_TARGET_URL=http://host.docker.internal:4000/webhooks/paybox

# Supplied optional services (not implemented by the application).
ELASTICSEARCH_URL=http://localhost:9200
PAYBOX_URL=http://localhost:4030
PAYBOX_SECRET_KEY=REPLACE_WITH_PAYBOX_SECRET_KEY
PAYBOX_PUBLISHABLE_KEY=REPLACE_WITH_PAYBOX_PUBLISHABLE_KEY
PAYBOX_WEBHOOK_SECRET=REPLACE_WITH_PAYBOX_WEBHOOK_SECRET
