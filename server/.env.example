# Copy to .env and replace REPLACE_* values using the supplied simulator setup.
# Node 22+ loads server/.env; exported/checker variables take precedence.
# URLs below use the existing Compose services' published host ports.
PORT=4000
WEB_ORIGIN=http://localhost:5173
# Must match the checker's GRADER_TOKEN.
GRADER_TOKEN=REPLACE_WITH_GRADER_TOKEN
MONGO_URL=mongodb://localhost:27017/switchboard
REDIS_URL=redis://localhost:6379
PIGEON_URL=http://localhost:4010
PIGEON_WEBHOOK_SECRET=REPLACE_WITH_PIGEON_WEBHOOK_SECRET
PIGEON_KEY_WS_ACME=REPLACE_WITH_ACME_API_KEY
PIGEON_KEY_WS_GLOBEX=REPLACE_WITH_GLOBEX_API_KEY
OIDC_ISSUER=http://localhost:4020
OIDC_CLIENT_ID=switchboard-web
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
# Must be a callback registered with the provided IdP (LB port, not instance PORT).
OIDC_REDIRECT_URI=http://localhost:4000/auth/callback
# Search and billing are not implemented; their variables are not required.
